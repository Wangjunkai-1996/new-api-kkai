# Backend-only build for frontend development.
# The external_frontend tag removes static embed requirements; the Rsbuild
# dev server supplies the UI and proxies API requests to this container.

FROM golang:1.26.1-alpine AS builder

ENV GO111MODULE=on CGO_ENABLED=0
ARG TARGETOS
ARG TARGETARCH
ENV GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64}
ENV GOEXPERIMENT=greenteagc
ENV FRONTEND_MODE=external

WORKDIR /build

ADD go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -tags=external_frontend -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM debian:bookworm-slim

# The runtime image has no embedded frontend assets, so keep the backend in
# external mode after the multi-stage boundary as well.
ENV FRONTEND_MODE=external

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-ca-certificates

COPY --from=builder /build/new-api /
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
