#!/usr/bin/env python3.11
"""Consume ai-risk JSONL events and apply durable local guard actions."""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


DEFAULT_STATE_DIR = Path("/var/lib/ai-risk-guard")
DEFAULT_EVENTS_FILE = DEFAULT_STATE_DIR / "events.jsonl"
DEFAULT_BLACK_IP_FILE = Path("/var/lib/ai-bridge/black_ip")
DEFAULT_BRIDGE_BLACK_LOG_FILE = Path("/var/lib/ai-bridge/black_log")
DEFAULT_LOCK_FILE = Path("/run/ai-risk-guard/daemon.lock")
DEFAULT_DB_CONTAINER = "new-api-postgres"
DEFAULT_DB_NAME = "newapi"
DEFAULT_DB_USER = "newapi"

IP_FIELDS = ("ip", "client_ip", "remote_addr", "remote_ip", "source_ip")
TOKEN_FIELDS = ("token_key", "token", "key", "api_key", "api_key_full", "authorization")
TOKEN_ID_FIELDS = ("token_id", "tokenId")
TOKEN_HASH_FIELDS = ("api_key_hash", "token_key_md5", "token_md5")
TOKEN_SUFFIX_FIELDS = ("api_key_suffix", "token_suffix", "key_suffix")
USER_FIELDS = ("user_id", "userId", "uid")
SENSITIVE_FIELD_NAMES = {
    "authorization",
    "token",
    "token_key",
    "api_key",
    "api_key_full",
    "key",
}
SECRET_EVIDENCE_FIELD_HINTS = ("hash", "sha", "md5", "fingerprint", "suffix")
BEARER_TOKEN_RE = re.compile(r"(?i)\bbearer\s+([A-Za-z0-9._~+/=-]{8,})")
SK_TOKEN_RE = re.compile(r"\bsk-[A-Za-z0-9._~+/=-]{8,}")
QUERY_API_KEY_RE = re.compile(r"(?i)([?&]api_key=)([^&#\s]+)")
LONG_HEX_SECRET_RE = re.compile(r"\b[0-9a-fA-F]{32,}\b")
LONG_BASE64_SECRET_RE = re.compile(r"\b(?=[A-Za-z0-9+/=_-]*[+/=_-])(?=[A-Za-z0-9+/=_-]*[A-Za-z])[A-Za-z0-9+/=_-]{32,}\b")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def ensure_dir(path: Path, mode: int = 0o750, force: bool = False) -> None:
    existed = path.exists()
    path.mkdir(parents=True, exist_ok=True)
    if existed and not force:
        return
    try:
        os.chmod(path, mode)
    except PermissionError:
        pass


def ensure_parent(path: Path, mode: int = 0o750) -> None:
    ensure_dir(path.parent, mode)


def write_private(path: Path, text: str, mode: int = 0o600) -> None:
    ensure_parent(path)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
    fd = os.open(path, flags, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)


def append_jsonl(path: Path, item: dict[str, Any], mode: int = 0o600) -> None:
    ensure_parent(path)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, mode)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(item, sort_keys=True, separators=(",", ":")) + "\n")
        fh.flush()
        os.fsync(fh.fileno())


def load_offset(path: Path, default: int = 0) -> int:
    try:
        return int(path.read_text(encoding="utf-8").strip() or "0")
    except FileNotFoundError:
        return default
    except ValueError:
        return default


def save_offset(path: Path, offset: int) -> None:
    tmp = path.with_suffix(".tmp")
    write_private(tmp, f"{offset}\n")
    os.replace(tmp, path)


def normalized_token_key(raw: Any) -> str | None:
    if raw is None:
        return None
    value = str(raw).strip()
    if not value:
        return None
    if value.lower().startswith("bearer "):
        value = value[7:].strip()
    if value.startswith("sk-"):
        value = value[3:]
    return value or None


def md5_token_key(raw: Any) -> str | None:
    token = normalized_token_key(raw)
    if not token:
        return None
    return hashlib.md5(token.encode()).hexdigest()


def safe_user_id(raw: Any) -> int | None:
    if raw is None or raw == "":
        return None
    try:
        user_id = int(raw)
    except (TypeError, ValueError):
        return None
    return user_id if user_id > 0 else None


def first_present(event: dict[str, Any], fields: tuple[str, ...]) -> Any:
    for field in fields:
        if field in event and event[field] not in ("", None):
            return event[field]
    return None


def extract_targets(event: dict[str, Any]) -> tuple[str | None, str | None, int | None]:
    ip = first_present(event, IP_FIELDS)
    token_key = normalized_token_key(first_present(event, TOKEN_FIELDS))
    user_id = safe_user_id(first_present(event, USER_FIELDS))
    return (str(ip).strip() if ip else None, token_key, user_id)


def extract_token_lookup(event: dict[str, Any]) -> tuple[int | None, str | None, str | None]:
    token_id = safe_user_id(first_present(event, TOKEN_ID_FIELDS))
    token_hash = first_present(event, TOKEN_HASH_FIELDS)
    token_suffix = first_present(event, TOKEN_SUFFIX_FIELDS)
    return (
        token_id,
        str(token_hash).strip().lower() if token_hash else None,
        str(token_suffix).strip() if token_suffix else None,
    )


def normalized_ip(raw: str | None) -> str | None:
    if not raw:
        return None
    value = raw.strip()
    try:
        return str(ipaddress.ip_address(value))
    except ValueError:
        return None


def case_id_for(raw_line: str, event: dict[str, Any]) -> str:
    for field in ("risk_case_id", "riskCaseId", "case_id", "caseId", "incident_id", "incidentId"):
        if event.get(field):
            return re.sub(r"[^A-Za-z0-9_.:-]", "_", str(event[field]))[:120]
    digest = hashlib.sha256(raw_line.encode("utf-8", errors="replace")).hexdigest()[:16]
    return f"case-{int(time.time())}-{digest}"


def sql_literal(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"


def redacted_secret(value: Any) -> dict[str, Any]:
    token = normalized_token_key(value)
    return {
        "redacted": True,
        "sha256": hashlib.sha256(token.encode()).hexdigest() if token else None,
    }


def sanitize_secret_text(text: str) -> str:
    def redact_query_api_key(match: re.Match[str]) -> str:
        return match.group(1) + "[REDACTED]"

    sanitized = QUERY_API_KEY_RE.sub(redact_query_api_key, text)
    sanitized = BEARER_TOKEN_RE.sub("Bearer [REDACTED]", sanitized)
    sanitized = SK_TOKEN_RE.sub("[REDACTED]", sanitized)
    sanitized = LONG_HEX_SECRET_RE.sub("[REDACTED]", sanitized)
    return LONG_BASE64_SECRET_RE.sub("[REDACTED]", sanitized)


def should_redact_key(key: Any, parent_key: str | None) -> bool:
    key_name = str(key).lower()
    if key_name in SENSITIVE_FIELD_NAMES:
        return True
    return parent_key is not None and parent_key.lower() == "headers" and key_name == "authorization"


def should_preserve_secret_evidence(key: str | None) -> bool:
    key_name = (key or "").lower()
    return any(hint in key_name for hint in SECRET_EVIDENCE_FIELD_HINTS)


def redact_value(value: Any, parent_key: str | None = None) -> Any:
    if isinstance(value, dict):
        redacted: dict[str, Any] = {}
        for key, item in value.items():
            if should_redact_key(key, parent_key):
                redacted[key] = redacted_secret(item)
            else:
                redacted[key] = redact_value(item, str(key))
        return redacted
    if isinstance(value, list):
        return [redact_value(item, parent_key) for item in value]
    if isinstance(value, str):
        if should_preserve_secret_evidence(parent_key):
            return value
        return sanitize_secret_text(value)
    return value


def redact_event(event: dict[str, Any]) -> dict[str, Any]:
    return redact_value(event)


def redacted_event_line(event: dict[str, Any]) -> str:
    return json.dumps(redact_event(event), sort_keys=True, separators=(",", ":"))


def bridge_value(raw: Any) -> str | None:
    if raw in ("", None):
        return None
    if isinstance(raw, list):
        for item in raw:
            value = bridge_value(item)
            if value:
                return value
        return None
    if isinstance(raw, dict):
        if raw.get("utf8_lossy"):
            return str(raw["utf8_lossy"])
        if raw.get("hex"):
            try:
                return bytes.fromhex(str(raw["hex"])).decode("utf-8", errors="replace")
            except ValueError:
                return None
        return None
    return str(raw)


def bridge_header(headers: dict[str, Any], name: str) -> str | None:
    lowered = name.lower()
    for key, value in headers.items():
        if str(key).lower() == lowered:
            return bridge_value(value)
    return None


def first_xff_ip(raw: str | None) -> str | None:
    if not raw:
        return None
    return raw.split(",", 1)[0].strip() or None


def bridge_event_from_black_log(raw_line: str) -> dict[str, Any] | None:
    try:
        item = json.loads(raw_line)
    except json.JSONDecodeError:
        return None
    if not isinstance(item, dict) or item.get("event") != "cyber_policy_black":
        return None

    request = item.get("request") if isinstance(item.get("request"), dict) else {}
    headers = request.get("headers") if isinstance(request.get("headers"), dict) else {}
    x_real_ip = bridge_header(headers, "x-real-ip")
    xff_raw = bridge_header(headers, "x-forwarded-for")
    remote_addr = first_xff_ip(x_real_ip) or first_xff_ip(xff_raw) or bridge_value(request.get("client_ip"))
    api_key = bridge_value(request.get("api_key_full"))
    api_key_masked = bridge_value(request.get("api_key_masked"))
    api_key_hash = bridge_value(request.get("api_key_hash"))
    api_key_suffix = api_key[-8:] if api_key else None
    blocked_ms = bridge_value(item.get("blocked_at_unix_ms")) or str(int(time.time() * 1000))
    case_seed = f"{blocked_ms}:{api_key_hash or api_key_masked or remote_addr or 'unknown'}"
    case_id = "bridge-cyber-policy-" + re.sub(r"[^A-Za-z0-9_.:-]", "_", case_seed)[:96]

    return {
        "ts": bridge_value(item.get("blocked_at_utc")) or utc_now(),
        "risk_case_id": case_id,
        "severity": "critical",
        "action": "block",
        "enforce": True,
        "rule_id": "upstream_cyber_policy",
        "reason": (item.get("ban") or {}).get("reason") if isinstance(item.get("ban"), dict) else "upstream_cyber_policy",
        "remote_addr": remote_addr,
        "token": api_key,
        "api_key_masked": api_key_masked,
        "api_key_hash": md5_token_key(api_key) or api_key_hash,
        "api_key_suffix": api_key_suffix,
        "request_id": bridge_header(headers, "x-newapi-request-id"),
        "user_id": bridge_header(headers, "x-newapi-user-id"),
        "token_id": bridge_header(headers, "x-newapi-token-id"),
        "token_name": bridge_header(headers, "x-newapi-token-name"),
        "channel_id": bridge_header(headers, "x-newapi-channel-id"),
        "multi_key_index": bridge_header(headers, "x-newapi-multi-key-index"),
        "model": bridge_header(headers, "x-newapi-model"),
        "method": bridge_value(request.get("method")),
        "uri": bridge_value(request.get("uri")) or bridge_value(request.get("path")),
        "host": bridge_header(headers, "host"),
        "xff_raw": xff_raw,
        "user_agent": bridge_header(headers, "user-agent"),
        "bridge_black_log_sha256": hashlib.sha256(raw_line.encode("utf-8", errors="replace")).hexdigest(),
    }


class Pg:
    def __init__(self, container: str, db_name: str, db_user: str, dry_run: bool) -> None:
        self.container = container
        self.db_name = db_name
        self.db_user = db_user
        self.dry_run = dry_run

    def query(self, sql: str) -> str:
        if self.dry_run:
            return ""
        if not shutil.which("podman"):
            raise RuntimeError("podman is not installed or not in PATH")
        cmd = [
            "podman",
            "exec",
            "-i",
            self.container,
            "psql",
            "-U",
            self.db_user,
            "-d",
            self.db_name,
            "-At",
            "-v",
            "ON_ERROR_STOP=1",
            "-c",
            sql,
        ]
        result = subprocess.run(cmd, text=True, capture_output=True, check=False)
        if result.returncode != 0:
            raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "psql failed")
        return result.stdout.strip()


class Guard:
    def __init__(self, args: argparse.Namespace) -> None:
        self.args = args
        self.state_dir = Path(args.state_dir)
        self.events_file = Path(args.events)
        self.black_ip_file = Path(args.black_ip_file)
        self.bridge_black_log_file = Path(args.bridge_black_log_file) if args.bridge_black_log_file else None
        self.offset_file = self.state_dir / "events.offset"
        self.bridge_offset_file = self.state_dir / "bridge_black_log.offset"
        self.actions_log = self.state_dir / "actions.jsonl"
        self.error_log = self.state_dir / "errors.jsonl"
        self.cases_log = self.state_dir / "cases.jsonl"
        self.cases_dir = self.state_dir / "cases"
        self.pg = Pg(args.db_container, args.db_name, args.db_user, args.dry_run)

    def setup(self) -> None:
        os.umask(0o077)
        ensure_dir(self.state_dir, 0o755, force=True)
        ensure_dir(self.cases_dir)
        ensure_parent(self.events_file)
        ensure_parent(self.black_ip_file)
        if self.bridge_black_log_file:
            ensure_parent(self.bridge_offset_file)

    def log_action(self, case_id: str, action: str, target: dict[str, Any], result: str, extra: dict[str, Any]) -> None:
        append_jsonl(
            self.actions_log,
            {
                "action_id": str(uuid.uuid4()),
                "case_id": case_id,
                "ts": utc_now(),
                "action": action,
                "target": target,
                "result": result,
                **extra,
            },
        )

    def log_error(self, case_id: str | None, raw_line: str, message: str) -> None:
        append_jsonl(
            self.error_log,
            {
                "ts": utc_now(),
                "case_id": case_id,
                "error": message,
                "raw_sha256": hashlib.sha256(raw_line.encode("utf-8", errors="replace")).hexdigest(),
            },
        )

    def persist_evidence(self, case_id: str, raw_line: str, event: dict[str, Any]) -> None:
        case_dir = self.cases_dir / case_id
        ensure_dir(case_dir, 0o700)
        raw_sha256 = hashlib.sha256(raw_line.encode("utf-8", errors="replace")).hexdigest()
        append_jsonl(
            case_dir / "raw_event.redacted.jsonl",
            {"ts": utc_now(), "raw_sha256": raw_sha256, "raw": redacted_event_line(event)},
        )
        write_private(case_dir / "event.redacted.json", json.dumps(redact_event(event), indent=2, sort_keys=True) + "\n")
        append_jsonl(
            self.cases_log,
            {
                "case_id": case_id,
                "ts": utc_now(),
                "raw_sha256": raw_sha256,
                "summary": {
                    "ip": first_present(event, IP_FIELDS),
                    "has_token": normalized_token_key(first_present(event, TOKEN_FIELDS)) is not None,
                    "user_id": safe_user_id(first_present(event, USER_FIELDS)),
                    "reason": event.get("reason")
                    or event.get("risk_reason")
                    or event.get("rule_id")
                    or event.get("rule")
                    or event.get("risk_case_id"),
                    "action": event.get("action"),
                    "enforce": event.get("enforce"),
                },
            },
        )

    def add_black_ip(self, case_id: str, ip: str) -> None:
        if self.args.dry_run:
            self.log_action(case_id, "blacklist_ip", {"ip": ip}, "dry_run", {"previous_present": None})
            return

        ensure_parent(self.black_ip_file)
        fd = os.open(self.black_ip_file, os.O_RDWR | os.O_CREAT, 0o640)
        with os.fdopen(fd, "r+", encoding="utf-8") as fh:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
            content = fh.read()
            lines = [line.rstrip("\n") for line in content.splitlines()]
            previous_present = ip in lines
            if not previous_present:
                if content and not content.endswith("\n"):
                    fh.write("\n")
                fh.write(ip + "\n")
                fh.flush()
                os.fsync(fh.fileno())
            result = "already_present" if previous_present else "added"
        self.log_action(case_id, "blacklist_ip", {"ip": ip}, result, {"previous_present": previous_present})

    def disable_token_and_user(self, case_id: str, token_key: str) -> int | None:
        token_hash = hashlib.sha256(token_key.encode()).hexdigest()
        if self.args.dry_run:
            self.log_action(case_id, "disable_token", {"token_key_sha256": token_hash}, "dry_run", {})
            return None
        row = self.pg.query(
            "SELECT id,user_id,status FROM tokens WHERE key="
            + sql_literal(token_key)
            + " ORDER BY id LIMIT 1;"
        )
        if not row:
            self.log_action(case_id, "disable_token", {"token_key_sha256": token_hash}, "not_found", {})
            return None

        token_id_s, user_id_s, previous_status_s = (row.split("|") + ["", "", ""])[:3]
        token_id = safe_user_id(token_id_s)
        user_id = safe_user_id(user_id_s)
        previous_status = safe_user_id(previous_status_s)
        if token_id is None:
            self.log_action(case_id, "disable_token", {"token_key_sha256": token_hash}, "invalid_db_row", {"row": row})
            return None

        if previous_status == 2:
            result = "already_disabled"
        else:
            self.pg.query(f"UPDATE tokens SET status=2 WHERE id={token_id} AND status<>2;")
            result = "disabled"
        self.log_action(
            case_id,
            "disable_token",
            {"token_id": token_id, "token_key_sha256": token_hash},
            result,
            {"previous_status": previous_status},
        )
        return user_id

    def disable_token_by_id(
        self,
        case_id: str,
        token_id: int,
        token_hash: str | None = None,
        token_suffix: str | None = None,
    ) -> int | None:
        if self.args.dry_run:
            self.log_action(case_id, "disable_token", {"token_id": token_id}, "dry_run", {})
            return None
        row = self.pg.query(f"SELECT id,user_id,status,key FROM tokens WHERE id={token_id} ORDER BY id LIMIT 1;")
        if not row:
            self.log_action(case_id, "disable_token", {"token_id": token_id}, "not_found", {})
            return None

        token_id_s, user_id_s, previous_status_s, token_key = (row.split("|") + ["", "", "", ""])[:4]
        db_token_id = safe_user_id(token_id_s)
        user_id = safe_user_id(user_id_s)
        previous_status = safe_user_id(previous_status_s)
        if db_token_id is None:
            self.log_action(case_id, "disable_token", {"token_id": token_id}, "invalid_db_row", {"row": "|".join(row.split("|")[:3])})
            return None

        if token_hash and token_suffix:
            actual_hash = md5_token_key(token_key)
            actual_suffix = token_key[-len(token_suffix) :] if token_suffix and token_key else None
            if actual_hash and (actual_hash != token_hash or actual_suffix != token_suffix):
                self.log_action(
                    case_id,
                    "attribution_mismatch",
                    {"token_id": db_token_id},
                    "token_lookup_mismatch",
                    {
                        "event_token_key_md5": token_hash,
                        "event_token_suffix": token_suffix,
                        "db_token_key_md5": actual_hash,
                    },
                )

        if previous_status == 2:
            result = "already_disabled"
        else:
            self.pg.query(f"UPDATE tokens SET status=2 WHERE id={db_token_id} AND status<>2;")
            result = "disabled"
        self.log_action(case_id, "disable_token", {"token_id": db_token_id}, result, {"previous_status": previous_status})
        return user_id

    def disable_token_by_hash_suffix(self, case_id: str, token_hash: str, token_suffix: str) -> int | None:
        if not re.fullmatch(r"[0-9a-f]{32}", token_hash or "") or not token_suffix:
            self.log_action(case_id, "disable_token", {"token_lookup": "hash_suffix"}, "invalid_lookup", {})
            return None
        target = {"token_key_md5": token_hash, "token_suffix": token_suffix}
        if self.args.dry_run:
            self.log_action(case_id, "disable_token", target, "dry_run", {})
            return None

        rows = self.pg.query(
            "SELECT id,user_id,status,key FROM tokens WHERE right(key,"
            + str(len(token_suffix))
            + ")="
            + sql_literal(token_suffix)
            + " ORDER BY id;"
        )
        for row in rows.splitlines():
            token_id_s, user_id_s, previous_status_s, token_key = (row.split("|") + ["", "", "", ""])[:4]
            if md5_token_key(token_key) != token_hash:
                continue
            token_id = safe_user_id(token_id_s)
            user_id = safe_user_id(user_id_s)
            previous_status = safe_user_id(previous_status_s)
            if token_id is None:
                self.log_action(case_id, "disable_token", target, "invalid_db_row", {"row": "|".join(row.split("|")[:3])})
                return None
            if previous_status == 2:
                result = "already_disabled"
            else:
                self.pg.query(f"UPDATE tokens SET status=2 WHERE id={token_id} AND status<>2;")
                result = "disabled"
            self.log_action(case_id, "disable_token", {"token_id": token_id, **target}, result, {"previous_status": previous_status})
            return user_id

        self.log_action(case_id, "disable_token", target, "not_found", {})
        return None

    def disable_user(self, case_id: str, user_id: int) -> None:
        if self.args.dry_run:
            self.log_action(case_id, "disable_user", {"user_id": user_id}, "dry_run", {})
            return
        row = self.pg.query(f"SELECT id,status FROM users WHERE id={user_id} ORDER BY id LIMIT 1;")
        if not row:
            self.log_action(case_id, "disable_user", {"user_id": user_id}, "not_found", {})
            return
        db_user_id_s, previous_status_s = (row.split("|") + ["", ""])[:2]
        db_user_id = safe_user_id(db_user_id_s)
        previous_status = safe_user_id(previous_status_s)
        if db_user_id is None:
            self.log_action(case_id, "disable_user", {"user_id": user_id}, "invalid_db_row", {"row": row})
            return
        if previous_status == 2:
            result = "already_disabled"
        else:
            self.pg.query(f"UPDATE users SET status=2 WHERE id={db_user_id} AND status<>2;")
            result = "disabled"
        self.log_action(
            case_id,
            "disable_user",
            {"user_id": db_user_id},
            result,
            {"previous_status": previous_status},
        )

    def process_line(self, raw_line: str) -> None:
        stripped = raw_line.strip()
        if not stripped:
            return
        try:
            event = json.loads(stripped)
            if not isinstance(event, dict):
                raise ValueError("event is not a JSON object")
        except Exception as exc:
            self.log_error(None, raw_line, f"invalid json: {exc}")
            return

        case_id = case_id_for(raw_line, event)
        self.persist_evidence(case_id, raw_line, event)

        if event.get("enforce") is False:
            self.log_action(
                case_id,
                "evidence_only",
                {},
                str(event.get("action") or "not_enforced"),
                {"reason": event.get("reason") or event.get("rule_id") or event.get("risk_case_id")},
            )
            return

        raw_ip, token_key, event_user_id = extract_targets(event)
        token_id, token_hash, token_suffix = extract_token_lookup(event)
        ip = normalized_ip(raw_ip)
        token_owner_user_id = None

        if ip:
            self.add_black_ip(case_id, ip)
        elif raw_ip:
            self.log_error(case_id, raw_line, f"invalid ip: {raw_ip}")
        if token_id and not self.args.no_db:
            token_owner_user_id = self.disable_token_by_id(case_id, token_id, token_hash, token_suffix)
        elif token_key and not self.args.no_db:
            token_owner_user_id = self.disable_token_and_user(case_id, token_key)
        elif token_hash and token_suffix and not self.args.no_db:
            token_owner_user_id = self.disable_token_by_hash_suffix(case_id, token_hash, token_suffix)
        if event_user_id and token_owner_user_id and event_user_id != token_owner_user_id:
            self.log_action(
                case_id,
                "attribution_mismatch",
                {"token_owner_user_id": token_owner_user_id},
                "event_user_id_mismatch",
                {"event_user_id": event_user_id},
            )
        if token_owner_user_id and not self.args.no_db:
            self.disable_user(case_id, token_owner_user_id)
        if not any((ip, token_id, token_key, token_hash and token_suffix, token_owner_user_id)):
            self.log_action(case_id, "noop", {}, "no_targets", {})

    def process_bridge_black_log_line(self, raw_line: str) -> None:
        event = bridge_event_from_black_log(raw_line)
        if not event:
            return
        self.process_line(json.dumps(event, sort_keys=True, separators=(",", ":")))

    def consume_file(self, path: Path, offset: int, handler) -> int:
        try:
            size = path.stat().st_size
        except FileNotFoundError:
            return offset
        if size < offset:
            offset = 0
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            fh.seek(offset)
            while True:
                line = fh.readline()
                if not line:
                    break
                handler(line)
                offset = fh.tell()
        return offset

    def initial_bridge_offset(self) -> int:
        if not self.bridge_black_log_file:
            return 0
        offset = load_offset(self.bridge_offset_file, -1)
        if offset >= 0:
            return offset
        try:
            offset = self.bridge_black_log_file.stat().st_size
        except FileNotFoundError:
            offset = 0
        save_offset(self.bridge_offset_file, offset)
        return offset

    def run(self) -> None:
        self.setup()
        offset = load_offset(self.offset_file)
        bridge_offset = self.initial_bridge_offset()
        while True:
            offset = self.consume_file(self.events_file, offset, self.process_line)
            save_offset(self.offset_file, offset)
            if self.bridge_black_log_file:
                bridge_offset = self.consume_file(
                    self.bridge_black_log_file,
                    bridge_offset,
                    self.process_bridge_black_log_line,
                )
                save_offset(self.bridge_offset_file, bridge_offset)
            if self.args.once:
                return
            time.sleep(self.args.poll_interval)


@contextlib.contextmanager
def process_lock(lock_file: Path):
    ensure_parent(lock_file, 0o755)
    fd = os.open(lock_file, os.O_RDWR | os.O_CREAT, 0o600)
    with os.fdopen(fd, "w") as fh:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SystemExit(f"another ai-risk-guard process holds {lock_file}")
        yield


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--events", default=str(DEFAULT_EVENTS_FILE), help="JSONL event file written by Nginx Lua")
    parser.add_argument("--state-dir", default=str(DEFAULT_STATE_DIR), help="state/evidence directory")
    parser.add_argument("--black-ip-file", default=str(DEFAULT_BLACK_IP_FILE), help="ai-bridge black_ip file")
    parser.add_argument(
        "--bridge-black-log-file",
        default=str(DEFAULT_BRIDGE_BLACK_LOG_FILE),
        help="ai-bridge cyber_policy black_log to tail; set empty to disable",
    )
    parser.add_argument("--lock-file", default=str(DEFAULT_LOCK_FILE), help="single-process lock file")
    parser.add_argument("--db-container", default=DEFAULT_DB_CONTAINER)
    parser.add_argument("--db-name", default=DEFAULT_DB_NAME)
    parser.add_argument("--db-user", default=DEFAULT_DB_USER)
    parser.add_argument("--poll-interval", type=float, default=1.0)
    parser.add_argument("--once", action="store_true", help="process currently available events and exit")
    parser.add_argument("--dry-run", action="store_true", help="record intended actions without mutating black_ip or DB")
    parser.add_argument("--no-db", action="store_true", help="skip token/user database changes")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    with process_lock(Path(args.lock_file)):
        Guard(args).run()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
