[Unit]
Description=AI Risk Guard daemon
Documentation=file:/opt/ai-risk-guard/README.md
After=network-online.target podman.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=ai-risk-guard
RuntimeDirectoryMode=0755
ExecStartPre=/bin/sh -c 'mkdir -p /var/lib/ai-risk-guard && touch /var/lib/ai-risk-guard/events.jsonl && chown root:root /var/lib/ai-risk-guard && chmod 0755 /var/lib/ai-risk-guard && chown www:root /var/lib/ai-risk-guard/events.jsonl && chmod 0600 /var/lib/ai-risk-guard/events.jsonl'
ExecStart=/usr/bin/python3.11 /opt/ai-risk-guard/bin/ai-risk-guardd
ExecStartPost=/bin/chmod 0755 /var/lib/ai-risk-guard
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ai-risk-guard /var/lib/ai-bridge /run/ai-risk-guard

[Install]
WantedBy=multi-user.target
